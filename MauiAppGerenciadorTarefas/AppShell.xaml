<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:MauiAppGerenciadorTarefas.Views"
       x:Class="MauiAppGerenciadorTarefas.AppShell">

    <TabBar>
        <ShellContent x:Name="ListaTab"
                      Title="Tarefas"
                      ContentTemplate="{DataTemplate views:ListaTarefasPage}"
                      Route="lista" />

        <ShellContent x:Name="NovaTab"
                      Title="Nova"
                      ContentTemplate="{DataTemplate views:NovaTarefaPage}"
                      Route="nova" />
    </TabBar>

</Shell>
