<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiAppGerenciadorTarefas.ViewModels"
             x:Class="MauiAppGerenciadorTarefas.Views.NovaTarefaPage"
             x:DataType="vm:NovaTarefaViewModel"
             Title="Nova Tarefa">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Nome da Tarefa" FontSize="14" TextColor="Gray" />
            <Entry Placeholder="Digite o nome da tarefa"
                   Text="{Binding Nome, Mode=TwoWay}"
                   BackgroundColor="White" />

            <Label Text="Descrição" FontSize="14" TextColor="Gray" />
            <Editor Placeholder="Descreva a tarefa..."
                    Text="{Binding Descricao, Mode=TwoWay}"
                    HeightRequest="100"
                    BackgroundColor="White" />

            <Label Text="Data" FontSize="14" TextColor="Gray" />
            <DatePicker Date="{Binding Data, Mode=TwoWay}"
                        MinimumDate="{x:Static sys:DateTime.Today}"
                        xmlns:sys="clr-namespace:System;assembly=netstandard"
                        BackgroundColor="White" />

            <Button Text="Salvar Tarefa"
                    Command="{Binding SalvarCommand}"
                    BackgroundColor="#512BD4"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="16"
                    CornerRadius="8"
                    Margin="0,20,0,0" />

            <Button Text="Cancelar"
                    Command="{Binding VoltarCommand}"
                    BackgroundColor="Transparent"
                    TextColor="#512BD4"
                    BorderColor="#512BD4"
                    BorderWidth="1"
                    CornerRadius="8" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
